# Copy to docker-compose.override.yml and customize
# This file is NOT gitignored - it's a template
services:
  convert-service:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        ENABLE_PGO: "true"
        ARCH_FLAGS: "-march=native"
    image: archive-video-av1:local
    volumes:
      - /your/local/path:/videos
      - app-data:/app/data
    # Settings are made on the Settings page; a variable set here locks its field.
    # ports:
    #   - "8001:8000"
    #   - "9988:9988/udp"

volumes:
  app-data:
